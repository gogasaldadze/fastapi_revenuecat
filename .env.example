# Copy to .env and fill in. See docs/configuration.md for every option.

DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
# Row lock wait on Postgres before a request gives up with 503
LOCK_TIMEOUT_MS=3000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# RevenueCat dashboard, Project settings, API keys, Secret API key (starts with sk_)
REVENUECAT_SECRET_KEY=
# Any long random string. Paste the same value into the webhook Authorization header.
REVENUECAT_WEBHOOK_SECRET=
# Entitlement identifier, exactly as it appears in the RevenueCat dashboard
REVENUECAT_ENTITLEMENT_ID=premium
ALLOW_SANDBOX_SUBSCRIPTIONS=false
ENTITLEMENT_CACHE_TTL_SECONDS=300
REVENUECAT_TIMEOUT_SECONDS=10
REVENUECAT_RETRY_DELAY_SECONDS=0.5
STORE_WEBHOOK_PAYLOADS=true

FREE_DAILY_UNITS=20
PREMIUM_DAILY_UNITS=1000
FEATURE_WEIGHTS={"basic": 1, "heavy": 10}
FAIL_OPEN_FEATURES=["basic"]
